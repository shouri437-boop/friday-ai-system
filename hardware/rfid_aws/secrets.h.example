#ifndef SECRETS_H
#define SECRETS_H

// WiFi Credentials
const char* ssid = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";

// AWS Endpoint (e.g. xxxxxxxxxxxxxx-ats.iot.your-region.amazonaws.com)
const char* mqtt_server = "YOUR_AWS_IOT_ENDPOINT.iot.amazonaws.com";

// Amazon Root CA 1 Certificate
const char* root_ca = R"EOF(
-----BEGIN CERTIFICATE-----
YOUR_AMAZON_ROOT_CA_HERE
-----END CERTIFICATE-----
)EOF";

// AWS IoT Device Certificate
const char* certificate_pem_crt = R"KEY(
-----BEGIN CERTIFICATE-----
YOUR_DEVICE_CERTIFICATE_PEM_HERE
-----END CERTIFICATE-----
)KEY";

// AWS IoT Device Private Key (KEEP THIS PRIVATE AND DO NOT COMMIT)
const char* private_pem_key = R"KEY(
-----BEGIN RSA PRIVATE KEY-----
YOUR_AWS_RSA_PRIVATE_KEY_HERE
-----END RSA PRIVATE KEY-----
)KEY";

#endif
